#include "/Engine/Public/Platform.ush"
#include "/DLSS5NR/Private/DLSS5NRMotionCommon.ush"

// DLSS5NR UE scene-depth guide resolve.
// Copies the active UE depth subrect into a compact, zero-based R32_FLOAT texture.

Texture2D<float> DepthTexture;
int2 SourceRectMin;
int2 SourceRectSize;
int2 OutputSize;
RWTexture2D<float> OutputDepth;

[numthreads(8, 8, 1)]
void DepthMainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const uint2 LocalPixel = DispatchThreadId.xy;
    if (LocalPixel.x >= (uint)OutputSize.x || LocalPixel.y >= (uint)OutputSize.y)
    {
        return;
    }

    const int2 SourcePixel = DLSS5NRMapGuide(LocalPixel,OutputSize,SourceRectMin,SourceRectSize);
    OutputDepth[LocalPixel] = DepthTexture.Load(int3(SourcePixel, 0)).r;
}
