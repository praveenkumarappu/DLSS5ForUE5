#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"

// Dense UE motion-vector guide resolve for NVIDIA DLSS-NR.
//
// Runs at the NR colour (display) resolution so the guide matches the post-upscale colour input,
// sampling the render-resolution depth/velocity textures. Output units are display pixels,
// previous-minus-current, +Y down: the convention NVIDIA's own UE DLSS plugin hands NGX with a
// unit MVScale (see Plugins/Nvidia/DLSS/Shaders/Private/VelocityCombine.usf).

Texture2D<float> DepthTexture;
Texture2D<float4> VelocityTexture;
int2 SourceRectMin;
int2 SourceRectSize;
int2 OutputSize;
uint HasObjectVelocity;
RWTexture2D<float2> OutputMotionVectors;

[numthreads(8, 8, 1)]
void MotionMainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const uint2 OutPixel = DispatchThreadId.xy;
    if (OutPixel.x >= (uint)OutputSize.x || OutPixel.y >= (uint)OutputSize.y)
    {
        return;
    }

    // Map the display pixel to the render-resolution scene textures (nearest).
    const float2 ViewportUV = (float2(OutPixel) + 0.5f) / float2(OutputSize);
    const int2 SourcePixel = SourceRectMin + min(int2(ViewportUV * float2(SourceRectSize)), SourceRectSize - 1);
    const float DeviceDepth = DepthTexture.Load(int3(SourcePixel, 0)).r;

    // ClipToPrevClip expects the active view's clip space, which is resolution independent.
    const float2 CurrentClipXY = float2(ViewportUV.x * 2.0f - 1.0f,
                                       1.0f - ViewportUV.y * 2.0f);

    float2 VelocityClip = 0.0f;
    bool bUseObjectVelocity = false;
    float4 EncodedVelocity = 0.0f;

    if (HasObjectVelocity != 0u)
    {
        EncodedVelocity = VelocityTexture.Load(int3(SourcePixel, 0));
        bUseObjectVelocity = EncodedVelocity.x > 0.0f;
    }

    if (bUseObjectVelocity)
    {
        // Use the engine decoder: UE 5.x stores velocity gamma-encoded (sqrt) on SM5+, and a linear
        // unpack turns an idle character's sub-pixel motion into tens of pixels.
        VelocityClip = DecodeVelocityFromTexture(EncodedVelocity).xy;
    }
    else
    {
        const float4 CurrentClip = float4(CurrentClipXY, DeviceDepth, 1.0f);
        const float4 PreviousClipH = mul(CurrentClip, View.ClipToPrevClip);

        if (abs(PreviousClipH.w) > 1.0e-6f)
        {
            const float2 PreviousClipXY = PreviousClipH.xy / PreviousClipH.w;
            VelocityClip = CurrentClipXY - PreviousClipXY;
        }
    }

    // UE velocity is current minus previous; NGX expects previous minus current, in pixels of
    // the texture being reprojected (the display-resolution colour).
    const float2 VelocityPixels = VelocityClip * float2(0.5f, -0.5f) * float2(OutputSize);
    OutputMotionVectors[OutPixel] = -VelocityPixels;
}
